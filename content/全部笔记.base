filters:
  and:
    - file.folder != "tags"
    - file.name != "404"
    - file.name != "index"
formulas:
  year: file.ctime.format("YYYY")
  date: file.ctime.format("YYYY年MM月DD日")
properties:
  file.name:
    displayName: 笔记
  formula.date:
    displayName: 日期
  file.tags:
    displayName: 标签
views:
  - type: table
    name: 归档
    groupBy:
      property: formula.year
      direction: DESC
    order:
      - file.name
      - formula.date
      - file.tags
    sort:
      - property: formula.date
        direction: DESC
      - property: file.name
        direction: ASC

{
  "name": "garden-island",
  "version": "1.0.0",
  "description": "A real-time 3D floating knowledge garden with three growth stages, camera navigation, search, and an accessible list fallback",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "esbuild src/garden.js --bundle --format=esm --target=es2020 --minify --outfile=dist/garden-island.js",
    "preview:fixture": "node scripts/generate-preview.mjs"
  },
  "quartz": {
    "name": "garden-island",
    "displayName": "Knowledge Garden",
    "category": "emitter",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 60,
    "defaultEnabled": false,
    "defaultOptions": {
      "slug": "garden",
      "limit": 50
    },
    "optionSchema": {
      "slug": {
        "type": "string"
      },
      "limit": {
        "type": "number"
      }
    }
  }
}
